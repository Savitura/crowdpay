# CrowdPay backend environment template. Copy it to backend/.env.
#
# On start the server runs validateEnv() (src/config/env.js) and exits when a
# rule fails; NODE_ENV=test skips it. Lines marked REQUIRED must have a value.
# Lines marked GENERATE hold placeholders that the validator rejects on
# purpose: replace them with your own values before the first start.
# docs/environment.md lists every rule.

# ── Server ───────────────────────────────────────────────
# Integer between 1 and 65535
PORT=3001
# development | production (test skips validation). production also requires
# an email provider and AWS KMS for wallet secrets, see the sections below.
NODE_ENV=development

# Public-facing base URL of this backend. Used to derive the embed widget's
# CSP connect-src (http/https and the matching ws/wss). Defaults to
# http://localhost:3001. Set this on dev/staging/production as appropriate.
# BACKEND_URL=https://api.crowdpay.com

# ── Database ─────────────────────────────────────────────
# REQUIRED. PostgreSQL connection string (docker-compose.yml overrides it with
# the db service).
DATABASE_URL=postgres://crowdpay:crowdpay@localhost:5432/crowdpay
# Database connection pool (positive integers; an invalid value stops startup)
DB_POOL_MAX=10           # max concurrent connections (default 10)
DB_IDLE_TIMEOUT_MS=30000 # close idle connections after 30s
DB_CONNECTION_TIMEOUT_MS=5000  # fail if no connection available within 5s

# ── Auth ─────────────────────────────────────────────────
# REQUIRED. Signs session tokens. Use at least 32 characters (shorter values
# only print a warning). Replace the placeholder outside local development.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-random-256-bit-secret
# Access token lifetime. When unset the server warns and uses 15m.
JWT_EXPIRES_IN=7d
# REQUIRED. Issuer (iss) and audience (aud) claims of every session token.
# These are the values the auth middleware falls back to.
JWT_ISSUER=https://crowdpay.io
JWT_AUDIENCE=crowdpay-api

# REQUIRED. Must differ from JWT_SECRET, or startup fails (key separation).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_PEPPER=replace-with-a-different-random-256-bit-secret

# OPTIONAL — pepper used to salt device fingerprints before storage (#595).
# Falls back to API_KEY_PEPPER when unset. Keep secret; rotating it resets clustering.
# DEVICE_FINGERPRINT_PEPPER=replace-with-another-random-256-bit-secret

# ── Feature flags ────────────────────────────────────────
# Selects the feature flag backend. Options: env (default), unleash, launchdarkly.
# If the configured provider is unreachable, the system falls back to env.
# FEATURE_FLAG_PROVIDER=env
#
# Unleash (https://getunleash.io)
# UNLEASH_URL=
# UNLEASH_INSTANCE_ID=
# UNLEASH_API_TOKEN=
# UNLEASH_PROJECT_NAME=default
# UNLEASH_ENVIRONMENT=development
#
# LaunchDarkly (https://launchdarkly.com)
# LAUNCHDARKLY_SDK_KEY=
# LAUNCHDARKLY_STREAMING=true

# ── Stellar ───────────────────────────────────────────────
# REQUIRED. Must be one of: testnet, mainnet
STELLAR_NETWORK=testnet
# REQUIRED. Horizon server for STELLAR_NETWORK.
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# USDC issuer address (differs between testnet and mainnet). Needed at startup:
# src/config/stellar.js builds the USDC asset from it, so it must be a valid
# public key (G...).
# Testnet:  GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# Mainnet:  GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Optional: add extra supported assets as JSON {"CODE":"ISSUER_ADDRESS"}
# STELLAR_EXTRA_ASSETS=

# ── Soroban / Smart contracts ─────────────────────────────────
# Set SOROBAN_ENABLED=true to deploy real contract instances on campaign creation.
# When Soroban is disabled, campaigns get null contract IDs (classic wallet path).
# Mock C… contract IDs are never persisted (#809).
#
# SOROBAN_ENABLED=false
#
# Option 1: Pre-deployed contracts (demo mode) — BOTH IDs required together.
# Escrow admin is the milestones contract (cross-contract releases).
# ESCROW_CONTRACT_ID=CXXXXXXXXXX...
# MILESTONES_CONTRACT_ID=CXXXXXXXXXX...
#
# Option 2: Per-campaign deployment (production mode)
# Requires WASM hashes from contracts/soroban (wasm32v1-none/release/*.wasm)
# ESCROW_WASM_HASH=
# MILESTONES_WASM_HASH=
#
# USDC token contract on Soroban (testnet example may differ)
# USDC_CONTRACT_ADDRESS=

# ── Fee Registry & Governance ───────────────────────────────
# Fee registry contract ID for on-chain fee management
# FEE_REGISTRY_CONTRACT_ID=
# Governance token ID (CROWD token issuer address)
# GOVERNANCE_TOKEN_ID=

# ── Platform wallet ───────────────────────────────────────
# REQUIRED, GENERATE. Stellar secret seed of the platform co-signer account:
# S followed by 55 characters from A-Z and 2-7 (56 in total). The placeholder
# below is rejected at startup.
# Generate a new keypair: https://laboratory.stellar.org/#account-creator
# (fund it on testnet with https://friendbot.stellar.org?addr=<PUBLIC_KEY>)
PLATFORM_SECRET_KEY=replace-with-platform-stellar-secret
# Largest withdrawal (in asset units) the server will sign with a custodial
# creator key. The server also holds the platform key, so for custodial creators
# it can satisfy the 2-of-2 multisig alone; bigger payouts need a Freighter creator.
# CUSTODIAL_WITHDRAWAL_LIMIT=1000
# REQUIRED, GENERATE. Stellar secret seed of the platform arbitrator account,
# same format as PLATFORM_SECRET_KEY. The placeholder is rejected at startup.
ARBITRATOR_SECRET_KEY=replace-with-arbitrator-stellar-secret

# REQUIRED. API key for the /api/ops endpoints, kept apart from user JWTs.
OPS_API_KEY=replace-with-a-random-256-bit-secret
# REQUIRED. HMAC secret for email unsubscribe tokens.
UNSUBSCRIBE_SECRET=replace-with-a-random-256-bit-secret
# REQUIRED. HMAC secret for impact seals.
IMPACT_SIGNING_SECRET=replace-with-a-random-256-bit-secret
# HMAC secret for campaign report signed URLs (falls back to JWT_SECRET)
# CAMPAIGN_REPORT_SIGNING_SECRET=replace-with-a-random-256-bit-secret

# REQUIRED, GENERATE. Key used by backend wallet encryption and recovery:
# exactly 32 bytes, written as 64 hex characters or as base64. The placeholder
# is rejected at startup. Keep it stable: changing it makes stored secrets
# unreadable.
# Generate a stable 32-byte secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WALLET_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

# GENERATE. Local key-encryption key for stored wallet secrets, checked at
# startup while WALLET_SECRET_PROVIDER is local (the default outside
# production): exactly 32 bytes, as 64 hex characters or base64. The
# placeholder is rejected at startup.
# Generate a stable 32-byte secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WALLET_SECRET_LOCAL_KEK=replace-with-a-32-byte-base64-key

# Local key-encryption key for stored integration secrets (API keys, webhooks),
# used while INTEGRATION_SECRET_PROVIDER is local: exactly 32 bytes, as 64 hex
# characters or base64. Not checked at startup: creating an API key or a
# webhook fails until it is replaced.
# Generate a stable 32-byte secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_SECRET_LOCAL_KEK=replace-with-a-32-byte-base64-key

# Secret providers. Outside production both default to local and use the keys
# above. With NODE_ENV=production both default to aws-kms, and the server
# refuses to start unless WALLET_SECRET_PROVIDER is aws-kms with AWS_REGION,
# WALLET_SECRET_KMS_KEY_ID, AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY set.
# In production, integration secrets need INTEGRATION_SECRET_PROVIDER=aws-kms
# and INTEGRATION_SECRET_KMS_KEY_ID with the same AWS settings (checked when a
# secret is first stored, not at startup).
# WALLET_SECRET_PROVIDER=local
# INTEGRATION_SECRET_PROVIDER=local
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# WALLET_SECRET_KMS_KEY_ID=
# INTEGRATION_SECRET_KMS_KEY_ID=

# The user ID (UUID from the users table) allowed to approve withdrawals
# Leave unset in development — all authenticated users can approve (dev mode only!)
# PLATFORM_APPROVER_USER_ID=

# ── Frontend (for CORS) ───────────────────────────────────
FRONTEND_URL=http://localhost:5173
# Optional comma-separated extra origins (in addition to FRONTEND_URL)
# CORS_ALLOWED_ORIGINS=https://app.crowdpay.com,https://admin.crowdpay.com

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=info

# ── Multi-channel notifications (issue #429) ──────────────
# Optional outbound providers. When unset, that channel is skipped (a no-op),
# so in-app notifications keep working with no extra config.
# Push provider HTTP endpoint (receives { to, title, body, data })
# PUSH_PROVIDER_URL=
# Firebase Admin service account JSON. Keep this server-side; never expose it
# to the browser. Create it in Firebase project settings > Service accounts.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
# SMS provider HTTP endpoint (receives { to, message })
# SMS_PROVIDER_URL=
# Hourly cron that flushes quiet-hours notification digests
# ENABLE_NOTIFICATION_QUIET_HOURS_CRON=true

# ── Email ─────────────────────────────────────────────────
# With NODE_ENV=production the server refuses to start unless SMTP_HOST or
# EMAIL_SERVICE_API_KEY is set, or DISABLE_EMAILS=true is set as an explicit
# opt-out (startup then prints a warning). Outside production both are
# optional and emails are not delivered without them.
# EMAIL_SERVICE_API_KEY alone sends through smtp.sendgrid.net:587 as "apikey".
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_SERVICE_API_KEY=
# EMAIL_FROM=
# DISABLE_EMAILS=false

# ── KYC / Identity verification ──────────────────────────
# Set to false to skip KYC on testnet / local dev
KYC_REQUIRED_FOR_CAMPAIGNS=false
# KYC_PROVIDER=persona   # persona | dev (dev only for local/test fake sessions)
# PERSONA_API_KEY=
# PERSONA_TEMPLATE_ID=
# PERSONA_WEBHOOK_SECRET=
# CONTRIBUTOR_IDENTITY_CONTRACT_ID=
# APP_BASE_URL=http://localhost:3001

# ── Embed widget contributions (#813) ────────────────────
# Production never simulates funding. Opt in only for local/test:
# ALLOW_EMBED_SIMULATED_CONTRIBUTIONS=true

# ── NFT reward minting (#815) ────────────────────────────
# Claims fail closed until both are set and a mint adapter exists.
# NFT_REWARDS_ENABLED=true
# NFT_REWARDS_CONTRACT_ID=

# ── GeoIP (session locations, login alerts) ──────────────
# Resolves login IPs to city/region/country for the session list and
# new-location alerts. Disabled by default — locations stay null.
# Lookups are best-effort: timeouts and provider outages never block a login.
# Misconfiguring a provider below fails startup rather than silently
# returning null locations forever.
# GEOIP_PROVIDER=none            # none | maxmind | ip-api | ipinfo
# GEOIP_TIMEOUT_MS=2000          # per-lookup network timeout
# GEOIP_CACHE_TTL_MS=86400000    # how long a resolved IP stays cached (24h)
# GEOIP_CACHE_MAX_ENTRIES=5000   # cap on cached IPs; oldest evicted first
#
# maxmind — local GeoLite2 DB, no network call, best privacy.
#   Requires the optional package: npm install maxmind
#   Download GeoLite2-City.mmdb (free account) from maxmind.com
# GEOIP_MAXMIND_DB_PATH=/var/lib/geoip/GeoLite2-City.mmdb
#
# ip-api — no key needed, but the free tier is HTTP-only (login IPs cross the
#   network in plaintext) and capped at 45 requests/minute per source IP.
#
# ipinfo — HTTPS, requires a token; sent as a bearer header, not a query param.
# GEOIP_IPINFO_TOKEN=

# ── Anchor / SEP-24 (fiat on-ramp) ───────────────────────
# ANCHOR_WALLET_HOME_DOMAIN=
# ANCHOR_WALLET_SIGNING_SECRET=
# ANCHOR_MONEYGRAM_ENABLED=true
# ANCHOR_MONEYGRAM_ENV=sandbox
MONEYGRAM_API_KEY=sandbox-api-key
STELLAR_ANCHOR_DOMAIN=extstellar.moneygram.com

# HMAC secret used to verify inbound SEP-24 provider callbacks.
# The anchor signs POST /api/anchor/callbacks/sep24 with this key using
# HMAC-SHA256 (X-Anchor-Signature: sha256=<hex>). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# When unset, signature verification is skipped in NODE_ENV=test/development ONLY.
# ANCHOR_CALLBACK_HMAC_SECRET=replace-with-a-random-256-bit-secret

# Replay-protection window for SEP-24 callbacks (seconds, default 300 = 5 min).
# Callbacks carrying an X-Anchor-Timestamp older than this are rejected.
# ANCHOR_CALLBACK_REPLAY_WINDOW_SECONDS=300

# Custom anchor (optional alternative to MoneyGram)
# ANCHOR_CUSTOM_ID=
# ANCHOR_CUSTOM_NAME=
# ANCHOR_CUSTOM_HOME_DOMAIN=
# ANCHOR_CUSTOM_WEB_AUTH_ENDPOINT=
# ANCHOR_CUSTOM_SEP24_ENDPOINT=
# ANCHOR_CUSTOM_SIGNING_KEY=
# ANCHOR_CUSTOM_ASSET_CODE=
# ANCHOR_CUSTOM_ASSET_ISSUER=
# ANCHOR_CUSTOM_NETWORK=testnet
# ANCHOR_CUSTOM_RAILS=

# ── Error tracking (Sentry) ───────────────────────────────
# Get DSN from sentry.io project settings. Leave empty to disable.
SENTRY_DSN=

# Fire a Sentry warning when reconciliation corrects raised_amount by at least this amount (asset units).
RECONCILIATION_DISCREPANCY_ALERT_THRESHOLD=1

# Object Storage (campaign covers). Optional, but STORAGE_BUCKET and
# STORAGE_ENDPOINT go together: setting only one of them stops startup.
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=

# Redis (rate limiting, idempotency keys). Defaults to redis://localhost:6379;
# docker-compose.yml points it at the redis service.
# REDIS_URL=redis://localhost:6379

# When set, GET /health/ready also probes this Soroban RPC endpoint
# (STELLAR_SOROBAN_RPC_URL is accepted as well).
# SOROBAN_RPC_URL=

# Maximum time (ms) each dependency check may take in GET /health/ready.
# HEALTH_CHECK_TIMEOUT_MS=2000

# ── Rate limiting ────────────────────────────────────────────
# Comma-separated list of wallet public keys (Stellar addresses) that bypass
# the contribution rate limiter. Intended ONLY for automated test accounts
# in non-production environments.
# ⚠️ SECURITY WARNING: Adding accounts here allows unlimited contribution
# requests. Never add real user accounts in production.
# RATE_LIMIT_BYPASS_ACCOUNTS=GAAAA...,GBBBB...

# ── Content Security Policy (#1070) ──────────────────────
# Used by `npm run csp:generate` to render frontend/nginx.conf and
# frontend/vercel.json. See docs/csp-reporting.md.
# CSP_REPORT_URI=/api/csp-report
# CSP_STELLAR_ORIGINS=https://horizon-testnet.stellar.org,https://soroban-testnet.stellar.org
# CSP_WALLET_ORIGINS=https://www.freighter.app,https://api.freighter.app
# CSP_ANCHOR_ORIGINS=https://extstellar.moneygram.com,https://stellar.moneygram.com
# CSP_OBSERVABILITY_ORIGINS=https://*.ingest.sentry.io
# CSP_IMAGE_ORIGINS=https://cdn.crowdpay.com,https://images.unsplash.com,https://ipfs.io
