# ── Stage 1: build ──────────────────────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

ARG SENTRY_RELEASE
ARG SENTRY_UPLOAD_SOURCEMAPS=false
ENV SENTRY_RELEASE=${SENTRY_RELEASE}
ENV VITE_SENTRY_RELEASE=${SENTRY_RELEASE}
ENV SENTRY_UPLOAD_SOURCEMAPS=${SENTRY_UPLOAD_SOURCEMAPS}

COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build  # outputs to /app/dist

# ── Stage 2: serve with nginx ───────────────────────────────────────────────
FROM nginx:1.25-alpine AS runner

# Create non-root user for security
RUN addgroup -g 1001 -S appgroup && \
    adduser -S appuser -u 1001 -G appgroup && \
    chown -R appuser:appgroup /var/cache/nginx

COPY --from=builder /app/dist /usr/share/nginx/html

# React Router needs fallback to index.html for client-side routing
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080
USER appuser
# pid /tmp is needed because /var/run is not writable by non-root
CMD ["nginx", "-g", "daemon off; pid /tmp/nginx.pid;"]
