# This file is not read by the backend or the frontend.
#
# Backend:  cp backend/.env.example backend/.env
#           (or backend/.env.demo.template for the Soroban demo)
# Frontend: cp frontend/.env.example frontend/.env (optional, see README)
#
# A .env file in the repository root is only read by Docker Compose to fill
# ${...} references in the compose files, such as SENTRY_RELEASE in
# docker-compose.prod.yml.
# SENTRY_RELEASE=
#
# See docs/environment.md for the variables the backend validates at startup.
